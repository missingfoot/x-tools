{
  "manifest_version": 3,
  "name": "X Tools",
  "version": "1.0.0",
  "description": "Logs the video posts you see on X into copyable lists, and adds download buttons to post images and videos.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content/history.js"],
      "run_at": "document_idle"
    }
  ]
}
